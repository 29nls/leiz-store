# ═══════════════════════════════════════════════════════════════
# LEIZ STORE - Environment Variables
# Salin file ini menjadi `.env` lalu isi nilainya.
#   cp .env.example .env
#
# ⚠️  KEAMANAN
#   - `.env` TIDAK boleh masuk repository (sudah di-gitignore).
#   - `NEXT_PUBLIC_*` → di-inline ke bundle browser saat BUILD time.
#     Boleh di-pass sebagai build-arg Docker (bersifat publik).
#   - Semua var lain adalah SECRET server-side → hanya lewat env saat
#     RUNTIME. Jangan pernah dipakai sebagai build-arg Docker.
# ═══════════════════════════════════════════════════════════════

# ── Aplikasi ──────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_SITE_URL=https://leizstore.com
CORS_ORIGINS=http://localhost:3000,https://leizstore.com
STORE_NAME=LEIZ STORE

# ── Supabase (Database & Auth) ────────────────────────────────
# Public — aman di-inline ke client bundle
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SECRET — server-only. JANGAN pernah di-pass sebagai build-arg Docker
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin Panel ───────────────────────────────────────────────
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-to-a-very-long-random-password
# Generate: openssl rand -base64 32
JWT_SECRET=generate-with-openssl-rand-base64-32
# Secret untuk aksi admin via Discord — random string panjang
DISCORD_ADMIN_SECRET=random-string
# Role ID Discord yang berhak menekan tombol aksi pembayaran di channel seller
# (accept/reject/cancel/force_cancel). Copy dari Discord → Server Settings →
# Roles → right-click role → "Copy Role ID".
# WAJIB di-set: jika kosong, semua tombol aksi pembayaran DITOLAK (fail closed).
DISCORD_ADMIN_ROLE_ID=
# Base64 dari 32 byte random. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PAYMENT_IDEMPOTENCY_ENCRYPTION_KEY=

# ── Cron / Job auth (protects /api/payments/expire & /api/cron/*) ──
CRON_SECRET=random-string

# ── Notifikasi (Discord / Telegram / WhatsApp) ────────────────
DISCORD_WEBHOOK_URL=
DISCORD_BOT_TOKEN=
DISCORD_SELLER_CHANNEL_ID=
DISCORD_PUBLIC_KEY=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WHATSAPP_API_KEY=
WHATSAPP_API_URL=

# ── Storage (S3 / R2 / Cloudflare) — untuk bukti bayar & invoice ──
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=auto
S3_PUBLIC_URL=
INVOICE_STORAGE_BUCKET=invoices

# ── Analytics / Tracking (opsional — biarkan kosong jika tidak dipakai) ──
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_HOTJAR_ID=
NEXT_PUBLIC_HOTJAR_SV=

# ── Docker Compose (dibaca oleh docker-compose.yml, opsional) ──
APP_PORT=3000
# Image name penuh (registry + repo), bisa di-override untuk fork / target lain
IMAGE_NAME=ghcr.io/29nls/leiz-store
IMAGE_TAG=latest
# Untuk profile `proxy` (Caddy + TLS otomatis):
DOMAIN=leizstore.com
ACME_EMAIL=admin@example.com
